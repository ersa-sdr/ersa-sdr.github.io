- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import os\nimport time\nimport numpy as np\nfrom gnuradio import\
      \ gr\n\n\nclass blk(gr.sync_block):\n    \"\"\"GNU Radio sink block for recording\
      \ raw complex64 I/Q samples.\"\"\"\n\n    IDLE = \"IDLE\"\n    RECORDING = \"\
      RECORDING\"\n    WAIT = \"WAIT\"\n\n    def __init__(self, team='Team-00', lab=1,\
      \ fc=100e6, fs=2.6e6,\n                 gain=0.0, record=False, max_seconds=5.0,\
      \ folder='.'):\n        gr.sync_block.__init__(self,\n                     \
      \          name='SDR Lab IQ Recorder',\n                               in_sig=[np.complex64],\n\
      \                               out_sig=None)\n\n        # Keep the parameter\
      \ names exactly as declared: GNU Radio updates these\n        # attributes when\
      \ the corresponding block parameters change at runtime.\n        self.team =\
      \ team\n        self.lab = lab\n        self.fc = fc\n        self.fs = fs\n\
      \        self.gain = gain\n        self.record = record\n        self.max_seconds\
      \ = max_seconds\n        self.folder = folder\n\n        # Internal state\n\
      \        self._state = self.IDLE\n        self._file = None\n        self._written\
      \ = 0\n        self._n_max = 0\n        self._start_settings = None\n\n    def\
      \ _open_file(self):\n        \"\"\"Create a new recording file and initialize\
      \ its per-file counters.\"\"\"\n        os.makedirs(self.folder, exist_ok=True)\n\
      \n        self._n_max = int(np.floor(float(self.max_seconds) * float(self.fs)))\n\
      \        # Round before converting to int, as required for floating-point\n\
      \        # frequency/sample-rate values supplied by GNU Radio.\n        fc_hz\
      \ = int(round(float(self.fc)))\n        fs_hz = int(round(float(self.fs)))\n\
      \        gain_db = float(self.gain)\n\n        # The required timestamp has\
      \ one-second resolution. If a recording\n        # with the same parameters\
      \ already used this exact name in this second,\n        # wait for the next\
      \ timestamp rather than silently overwriting it.\n        while True:\n    \
      \        timestamp = time.strftime('%Y%m%dT%H%M%S')\n            filename =\
      \ (\n                f\"{self.team}_lab{int(self.lab):02d}_\"\n            \
      \    f\"{fc_hz}_{fs_hz}_{gain_db:.1f}_{timestamp}.cf32\"\n            )\n  \
      \          filepath = os.path.join(self.folder, filename)\n            if not\
      \ os.path.exists(filepath):\n                break\n            time.sleep(0.05)\n\
      \n        self._file = open(filepath, 'wb')\n        self._written = 0\n   \
      \     self._start_settings = (float(self.fc), float(self.fs), float(self.gain))\n\
      \n        print(f\"[REC] start {filename}\")\n\n    def _close_file(self, reason):\n\
      \        \"\"\"Close the active file and print a summary of the recording.\"\
      \"\"\n        if self._file is None:\n            return\n\n        # Use the\
      \ sample rate captured when this file was opened. The live\n        # parameter\
      \ may already have changed when this helper is called.\n        start_fs = self._start_settings[1]\n\
      \        duration = (self._written / start_fs) if start_fs > 0 else 0.0\n\n\
      \        self._file.close()\n        self._file = None\n        print(f\"[REC]\
      \ stop  {self._written} samples = {duration:.2f} s ({reason})\")\n\n    def\
      \ work(self, input_items, output_items):\n        x = input_items[0]\n\n   \
      \     if self._state == self.IDLE:\n            if self.record:\n          \
      \      # Guard: a recording shorter than one sample makes no sense.\n      \
      \          # Go to WAIT so the message is printed once, not on every call.\n\
      \                if float(self.max_seconds) * float(self.fs) < 1:\n        \
      \            print(\"[REC] error: max_seconds * fs < 1 sample, \"\n        \
      \                  \"nothing to record\")\n                    self._state =\
      \ self.WAIT\n                    return len(x)\n\n                # Guard: if\
      \ the folder/file cannot be created, report it and\n                # keep the\
      \ flowgraph (spectrum displays) running. WAIT means\n                # the next\
      \ attempt happens only after Record is re-ticked.\n                try:\n  \
      \                  self._open_file()\n                except OSError as e:\n\
      \                    print(f\"[REC] error: cannot open file ({e})\")\n     \
      \               self._file = None\n                    self._state = self.WAIT\n\
      \                    return len(x)\n\n                self._state = self.RECORDING\n\
      \n                # The first input batch must also be recorded.\n         \
      \       k = min(len(x), self._n_max - self._written)\n                if k >\
      \ 0:\n                    x[:k].tofile(self._file)\n                    self._written\
      \ += k\n\n                if self._written >= self._n_max:\n               \
      \     self._close_file('max_seconds reached')\n                    self._state\
      \ = self.WAIT\n\n        elif self._state == self.RECORDING:\n            #\
      \ Check conditions in the exact priority order from the lab spec.\n        \
      \    if not self.record:\n                self._close_file('record off')\n \
      \               self._state = self.IDLE\n\n            elif ((float(self.fc),\
      \ float(self.fs), float(self.gain))\n                  != self._start_settings):\n\
      \                self._close_file('settings changed')\n                self._state\
      \ = self.WAIT\n\n            else:\n                remaining = self._n_max\
      \ - self._written\n                k = min(len(x), remaining)\n            \
      \    if k > 0:\n                    x[:k].tofile(self._file)\n             \
      \       self._written += k\n\n                if self._written >= self._n_max:\n\
      \                    self._close_file('max_seconds reached')\n             \
      \       self._state = self.WAIT\n\n        elif self._state == self.WAIT:\n\
      \            if not self.record:\n                self._state = self.IDLE\n\
      \            # While record remains True, do nothing. This prevents a second\n\
      \            # file from starting until the user unchecks and checks Record.\n\
      \n        return len(x)\n\n    def stop(self):\n        if self._file is not\
      \ None:\n            self._close_file('flowgraph stopped')\n        return True\n"
    affinity: ''
    alias: ''
    comment: ''
    fc: f_tune
    folder: '"recordings"'
    fs: samp_rate
    gain: rf_gain
    lab: '1'
    max_seconds: rec_sec
    maxoutbuf: '0'
    minoutbuf: '0'
    record: rec
    team: team
  states:
    _io_cache: ('SDR Lab IQ Recorder', 'blk', [('team', "'Team-00'"), ('lab', '1'),
      ('fc', '100000000.0'), ('fs', '2600000.0'), ('gain', '0.0'), ('record', 'False'),
      ('max_seconds', '5.0'), ('folder', "'.'")], [('0', 'complex', 1)], [], 'GNU
      Radio sink block for recording raw complex64 I/Q samples.', ['fc', 'folder',
      'fs', 'gain', 'lab', 'max_seconds', 'record', 'team'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [656, 384.0]
    rotation: 0
    state: enabled
